import random
length=int(input("enter your length"))
def low_level_password():
    lower="abcdefghijklmnopqrstuvwxyz"
    password=""
    for i in range(0,length):
        password=password+random.choice(lower)
    return password
def medium_level_password():
    upper="ABCDEFGHIJKLMNOPQRSTUVWZXYZabcdefghijklmnopqrstuvwxyz"
    password=""
    for i in range(0,length):
        password=password+random.choice(upper)
    return password
def strong_level_password():
    mix="ABCDEFGHIJKLMNOPQRSTUVWZXYZabcdefghijklmnopqrstuvwxyz0123456789 !@#$%^&*()"
    password=""
    for i in range(0,length):
        password=password+random.choice(mix)
    return password
generate_password= low_level_password()
generate_password1= medium_level_password()
generate_password2=strong_level_password()
while True:
    print("OPTIONS:")
    print(" 'low' for low level password")
    print(" 'medium' for medium level password")
    print(" 'strong' for strong level password")
    print(" 'exit' for exiting password generator")
    user_input=input(" :")

    if user_input=="exit":
        break
    elif user_input in('low','medium','strong'):
        if user_input=='low':
            print("generated_password=",generate_password)
        elif user_input=='medium':
            print("generated_password=",generate_password1)
        elif user_input=='strong':
            print("generated_password=",generate_password2)
    else:
        print("unspecified input")
